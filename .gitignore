# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Test, coverage, and type-checking output
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Packaging output
build/
dist/
*.egg-info/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Source legal documents and generated text
data/legal_documents/*
!data/legal_documents/.gitkeep
# Keep legacy local source folders private during migration.
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
data/raw_DOCs/*
!data/raw_DOCs/.gitkeep
data/extracted_text/*
!data/extracted_text/.gitkeep

# Local Chroma vector database
data/chroma/*
!data/chroma/.gitkeep
