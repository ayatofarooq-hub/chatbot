    },
    {
      "text": "صـورة عنـه إلـى : ",
      "type": "Paragraph"
    },
    {
      "text": "\t\t\tمكتب رئيس مجلس الوزراء / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "\t\t\tمجلس النواب العراقي / مكتب الأمين العام لمجلس النواب / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "\t\t\tرئاسة مجلس الوزراء / هيئة المستشارين / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "\t\t\t\t\t\tالهيئة العليا للتنسيق بين المحافظات / مكتب المنسق العام / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "\t\tالأمانة العامة لمجلس الوزراء / مكتب الأمين العام / للعلم ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "\t\tالأمانة العامة لمجلس الوزراء / مكتب نائب الأمين العام / للعلم ، مع التقدير ... ",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / الدائرة القانونية ( مكتب رئيس الدائرة ) / لأخذ ما يقتضي ، واعلامنا ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / دائرة شؤون مجلس الوزراء واللجان ( قسم متابعة تنفيذ قرارات وتوجيهات \nمجلس الوزراء ) / للتأشير والمتابعة ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانـة العامـة لمجلـس الوزراء / دائرة شؤون مجلس الوزراء واللجان / قسم متابعة اللجان والاوامر / لأخذ ما يقتضي وإعلامنا ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "\t\t\t\t\t\tالأمانة العامة لمجلس الوزراء / قسم البريد المركزي / للحفظ ، مع التقدير ...",
      "type": "Paragraph"
    },
