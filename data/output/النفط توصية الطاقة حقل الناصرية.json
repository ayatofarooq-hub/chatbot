    {
      "text": "",
      "type": "Paragraph"
    },
    {
      "text": "صـورة عنـه إلـى :",
      "type": "Paragraph"
    },
    {
      "text": "مكتب رئيس مجلس الوزراء / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ... ",
      "type": "Paragraph"
    },
    {
      "text": "مجلس النواب العراقي / مكتب الأمين العام لمجلس النواب / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "رئاسـة مجلـس الـوزراء / هيئـة المستشاريـن / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "وزارة التخطيط / مكتب الوزير / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "وزارة المالية / مكتب الوزير / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "ديوان الرقابة المالية الاتحادي / مكتب رئيس الديوان / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "محافظة ذي قار / مكتب المحافظ / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "المصرف العراقي للتجارة / مكتب رئيس مجلس الإدارة / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "المجلس الوزاري للطاقة / سكرتارية المجلس / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الهيئـــة العليا للتنسيـــق بين المحافظات / مكتب المنسق العام / ربطًا قراري مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / مكتب الأمين العام / للعلم ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / مكتب نائـب الأمين العام / للعلم ، مع التقدير ... ",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / الدائرة القانونية ( قسم الاستشارات ) / إشارة إلى مذكرتيكم المرقمتين \nبالعددين ( م د / ق/2/1/71/42/3525 س ) و ( م د/ق/2/1/905 ) المؤرختين في 17 و 19/11/2024 ) \nللعلم ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / دائرة شؤون مجلس الوزراء واللجان ( قسم متابعة تنفيذ قرارات وتوجيهات \nمجلس الوزراء ) / للتأشير والمتابعة ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانـة العامـة لمجلس الوزراء / قسـم البريـد المركـزي / للحفـظ ، مع التقديـر...",
      "type": "Paragraph"
    },
