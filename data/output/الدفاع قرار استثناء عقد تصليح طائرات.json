    },
    {
      "text": "صـورة عنـه إلـى :",
      "type": "Paragraph"
    },
    {
      "text": "مكتب رئيس مجلس الوزراء / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ... ",
      "type": "Paragraph"
    },
    {
      "text": "مجلس النواب العراقي / مكتب الأمين العام لمجلس النواب / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "رئاسـة مجلـس الـوزراء / هيئـة المستشاريـن / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "وزارة التخطيط / مكتب الوزير / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "وزارة المالية / مكتب الوزير / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "ديوان الرقابة المالية الاتحادي / مكتب رئيس الديوان / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الهيئـــة العليا للتنسيـــق بين المحافظات / مكتب المنسق العام / ربطًا قرار مجلس الوزراء / للاطلاع ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / مكتب الأمين العام / للعلم ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / مكتب نائـب الأمين العام / للعلم ، مع التقدير ... ",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / الدائرة القانونية ( قسم الاستشارات ) / إشارة إلى مذكرتكم المرقمة بالعدد \n( م د/ق/2/1/42/813 ل ق ) المؤرخة في 23/12/2024 / للعلم ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانة العامة لمجلس الوزراء / دائرة شؤون مجلس الوزراء واللجان ( قسم متابعة تنفيذ قرارات وتوجيهات \nمجلس الوزراء ) / للتأشير والمتابعة ، مع التقدير ...",
      "type": "Paragraph"
    },
    {
      "text": "الأمانـة العامـة لمجلس الوزراء / قسـم البريـد المركـزي / للحفـظ ، مع التقديـر...",
      "type": "Paragraph"
    },
