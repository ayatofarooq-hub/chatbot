<Window x:Class="LegalChatbotDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Jalsah"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
  <Grid>
    <Grid x:Name="SplashView" Background="#F6F7F9">
      <Border Width="520"
              Padding="32"
              Background="White"
              BorderBrush="#DDE2E8"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Starting..."
                     FontSize="28"
                     FontWeight="SemiBold"
                     Foreground="#17202A" />
          <TextBlock x:Name="StatusText"
                     Margin="0,14,0,0"
                     Text="Launching backend process"
                     FontSize="15"
                     Foreground="#415062"
                     TextWrapping="Wrap" />
          <ProgressBar x:Name="StartupProgress"
                       Margin="0,24,0,0"
                       Height="10"
                       IsIndeterminate="True" />
          <TextBox x:Name="ErrorDetails"
                   Margin="0,18,0,0"
                   Height="180"
                   Visibility="Collapsed"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   FontSize="12" />
          <Button x:Name="RetryButton"
                  Margin="0,18,0,0"
                  Width="100"
                  Height="34"
                  HorizontalAlignment="Left"
                  Content="Retry"
                  Visibility="Collapsed"
                  Click="RetryButton_Click" />
        </StackPanel>
      </Border>
    </Grid>

    <wv2:WebView2 x:Name="BrowserView"
                  Visibility="Collapsed" />
  </Grid>
</Window>
